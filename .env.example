# Alpaca market-data shadow credentials. Never commit actual values.
ALPACA_DATA_KEY=replace_with_market_data_key_id
ALPACA_DATA_SECRET=replace_with_market_data_secret
# Local-only endpoint for compatible consumers. The relay (not consumers) uses
# the data credentials above and owns the sole Alpaca crypto WebSocket.
ALPACA_CRYPTO_LOCAL_FEED_URL=ws://127.0.0.1:8766
# Real-time stock feed: iex or sip. The command also accepts --feed explicitly.
ALPACA_DATA_FEED=iex

# Alpaca PAPER execution credentials and stable SHAD0W account binding.
# For ordinary Alpaca Trading API accounts these may intentionally be the same
# underlying keypair as ALPACA_DATA_KEY/ALPACA_DATA_SECRET.  Keep the names
# separate: SHAD0W models market data and PAPER execution as different authority
# surfaces. SHADOW_PAPER_ACCOUNT_ID is the human-facing account_number, not UUID id.
ALPACA_PAPER_API_KEY_ID=replace_with_paper_trading_key_id
ALPACA_PAPER_API_SECRET_KEY=replace_with_paper_trading_secret
SHADOW_PAPER_ACCOUNT_ID=replace_with_paper_account_number
